          "name": "Hold Activity",
          "request": {
            "name": "Hold Activity",
            "description": {
              "content": "Hold activity and set activity status to `ON_HOLD` only for manual activities such as control or physical delivering.\n\nIf the activity is already terminated (status `ARCHIVED`, `CANCELED`, `FAILED` or `SUCCESSED`), the response is an HTTP `400` error code.\n\nThis endpoints **should not be forged** but retrieved from the `_links` map in list activities response or any endpoint that create or modify an activity.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "activities",
                ":activityId",
                "hold"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
