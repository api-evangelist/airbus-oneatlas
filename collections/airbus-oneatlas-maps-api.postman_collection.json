      "item": [
        {
          "id": "7560922b-c9ad-4e61-9a0b-ed7e744fc4de",
          "name": "Returns a Tile from a Layer.",
          "request": {
            "name": "Returns a Tile from a Layer.",
            "description": {
              "content": "Returns a 256x256 tile from a layer in JPEG or PNG format.\n\n__IMPORTANT:__ whatever the requested image format is, a transparent image will be delivered in PNG format if no tile is found at the specified location.\n\n__Example__: https://view-bm.api.oneatlas.airbus.com/basemap/wmts?layer=advancedBasemap&style=default&tilematrixset=3857&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/unknown&TileMatrix=18&TileCol=132063&TileRow=95710\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "basemap",
                "wmts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "layer",
                  "value": "advancedBasemap"
                },
                {
                  "key": "tilematrixset",
                  "value": "{{tileSet}}"
                },
                {
                  "key": "Service",
                  "value": "{{service}}"
                },
                {
                  "key": "Request",
                  "value": "{{request}}"
                },
                {
                  "key": "Version",
                  "value": "1.0.0"
                },
                {
                  "key": "Format",
                  "value": "{{format}}"
                },
                {
                  "key": "TileMatrix",
                  "value": "{{zoomLevel}}"
                },
                {
                  "key": "TileCol",
                  "value": "{{tileColumn}}"
                },
                {
                  "key": "TileRow",
                  "value": "{{tileRow}}"
                }
              ],
              "variable": []
            },
            "method": "GET"
          },
          "response": [
            {
              "id": "33af7a52-e02d-4058-bb7c-5e2708a4f56c",
              "name": "Request successful - returns the requested tile as an image.",
              "originalRequest": {
