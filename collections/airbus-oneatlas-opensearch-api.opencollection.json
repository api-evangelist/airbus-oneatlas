{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneAtlas WorldDEM Access Opensearch API",
    "version": "1.0.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Opensearch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v1/opensearch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sar.api.oneatlas.airbus.com/v1/api/v1/opensearch"
          }
        }
      ]
    }
  ],
  "bundled": true
}