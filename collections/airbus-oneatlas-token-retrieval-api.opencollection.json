{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneAtlas WorldDEM Access Token retrieval API",
    "version": "1.0.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token retrieval",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate Using an API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sar.api.oneatlas.airbus.com/v1/auth/realms/IDP/protocol/openid-connect/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "apikey",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Authenticate Using an API Key"
        }
      ]
    }
  ],
  "bundled": true
}